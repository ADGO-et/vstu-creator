# Local overrides for this stack only (never commit a real .env)
IMAGE_NAME=ghcr.io/adgo-et/vstu-creator
IMAGE_TAG=dev

# Dedicated host port — 3082 (3080=student, 3081=admin)
HOST_PORT=3082

# Required at build time — set in GitHub Actions secret VITE_API_BASE_URL
# Same backend as student/admin, must include /api
VITE_API_BASE_URL=
